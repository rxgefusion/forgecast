# Gradle
.gradle/
build/
out/

# Loom
.fabric/
run/
remappedSrc/

# IDE
.idea/
*.iml
# .vscode/ - Loom generates launch configs here, keep them
!.vscode/launch.json
.settings/
.classpath
.project

# Secrets. A Hypixel API key is a UUID and is easy to paste somewhere and forget.
# See SecretsGuardTest for where a key SHOULD live (never in this repo).
#
# These are deliberately NARROW. An earlier version used *secret*, *apikey* and
# *credentials*, which matched SecretsGuardTest.kt itself and quietly kept the
# guard out of the repository - a rule that disabled the thing enforcing it.
.env
*.pem
*.p12
*.keystore
*.token
secrets.properties
secrets.json
secrets.txt
api-key.txt
apikey.txt
api_key.txt
credentials.json
/secrets/

# Source is never a secret, whatever it is called.
!*.kt
!*.java
