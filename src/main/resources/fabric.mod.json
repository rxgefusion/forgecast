{
	"schemaVersion": 1,
	"id": "forgecast",
	"version": "${version}",
	"name": "ForgeCast",
	"description": "Fabric mod for Hypixel SkyBlock, written in Kotlin. Not a Forge mod, despite the name.",
	"authors": [
		"Fraust"
	],
	"license": "LGPL-3.0-only",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"adapter": "kotlin",
				"value": "dev.fraust.forgecast.ForgeCast"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.13.13"
	}
}
